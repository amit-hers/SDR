@@ -162,6 +162,11 @@ static int write_cr(struct spi_flash *flash, u8 wc)
 #endif
 
 #ifdef CONFIG_SPI_FLASH_BAR
+#ifdef CONFIG_PLUTO_QSPI_DIAGNOSTIC
+/* Set only by the FIT programmer, around the erase/write it must perform. */
+int pluto_qspi_allow_bank_change;
+#endif
+
 static int spi_flash_write_bar(struct spi_flash *flash, u32 offset)
 {
 	u8 cmd, bank_sel, upage_curr;
@@ -186,6 +191,20 @@ static int spi_flash_write_bar(struct spi_flash *flash, u32 offset)
 	}
 
 	cmd = flash->bank_write_cmd;
+#ifdef CONFIG_PLUTO_QSPI_DIAGNOSTIC
+	/*
+	 * A diagnostic READ must never change EAR/BAR state, so refuse by
+	 * default. The programmer has to move the bank exactly once -- the
+	 * part powers up with EAR=1 here, and the FIT region at physical
+	 * 0x00200000 lives in bank 0 -- so it opts in explicitly for the
+	 * duration of the erase/write, and clears the flag afterwards.
+	 */
+	if (!pluto_qspi_allow_bank_change) {
+		printf("SF diagnostic: refusing bank change %u -> %u\n",
+		       flash->bank_curr, bank_sel);
+		return -EPERM;
+	}
+#endif
 	ret = spi_flash_write_common(flash, &cmd, 1, &bank_sel, 1);
 	if (ret < 0) {
 		debug("SF: fail to write bank register\n");
@@ -1097,9 +1116,15 @@ static int spi_flash_set_qeb_winspan(struct spi_flash *flash)
 	) {
 		debug("SF: winspan: QEB is already set\n");
 	} else {
+#ifdef CONFIG_PLUTO_QSPI_DIAGNOSTIC
+		/* Never write the Winbond configuration/status register. */
+		debug("SF diagnostic: leaving QEB unchanged\n");
+		return 0;
+#else
 		ret = write_cr(flash, STATUS_QEB_WINSPAN);
 		if (ret < 0)
 			return ret;
+#endif
 	}
 
 	return ret;
