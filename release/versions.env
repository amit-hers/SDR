# Single source of truth for the FPGA/software contract.
#
# These numbers are compiled INTO the bitstream (via sdr_version_id.tcl) and
# checked at runtime by fpga_abi_check.sh. Changing one here without rebuilding
# the FPGA is what the check exists to catch, so they live in exactly one file
# and both sides read it.
#
# MAGIC        never changes. Proves the window holds our identity block at all,
#              as opposed to an unmapped address that happens to read plausibly.
# FPGA_ABI     bump when the MEANING of a register changes -- a field widens, a
#              value is reinterpreted, a bit is repurposed. Software built for a
#              different ABI must refuse to run.
# REGMAP_VER   bump when a register MOVES or is added. Adding one HLS scalar
#              once shifted bpsk_mode from 0x18 to 0x24 and silently broke every
#              script writing the old address; this is the counter that makes
#              that visible instead of mysterious.
# FPGA_VERSION human-facing 0x00MMmmpp. Informational: never gate on it, because
#              a patch release must not be able to lock software out.

SDR_MAGIC=0x5344524C
SDR_FPGA_ABI=3
SDR_REGMAP_VER=3
SDR_FPGA_VERSION=0x00010300

# What the software of THIS source tree requires of the FPGA.
SDR_SW_ABI=3
SDR_SW_REGMAP=3

# Where the identity block is mapped. sdr_version_id.tcl must agree.
SDR_ID_BASE=0x43C50000
